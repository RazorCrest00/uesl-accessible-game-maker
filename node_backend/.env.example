# Copy this file to .env and fill in your credentials.
# The server will send real emails when SMTP_USER and SMTP_PASS are set.
# If they are blank the server falls back to "dev mode" and returns the
# code in the API response (visible in the UI when running on localhost).

# ── Gmail example ─────────────────────────────────────────────────────────
# 1. Go to myaccount.google.com → Security → 2-Step Verification → App passwords
# 2. Generate a password for "Mail" / "Other"
# 3. Paste it as SMTP_PASS below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Datastream <your-email@gmail.com>"

# ── Server port (default 3000) ─────────────────────────────────────────────
PORT=3000

# ── Groq API (free at console.groq.com) ────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
